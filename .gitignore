# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 에디터·도구 로컬 설정 (개인 경로나 토큰이 들어갈 수 있음)
.vscode/
.idea/
.claude/
*.code-workspace

# 패키지 레지스트리 인증
.npmrc
.yarnrc.yml

# 자격 증명·키 (실수 방지용 광범위 차단)
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
secrets/
credentials*.json
serviceAccount*.json

# 로컬 전용 파일
*.local
!*.local.example
